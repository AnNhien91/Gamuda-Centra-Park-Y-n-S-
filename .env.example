# ===========================================================
#  Copy file này thành ".env" khi chạy trên máy tính.
#  Trên Hostinger: nhập từng biến trong mục Environment variables.
#  KHÔNG đưa file .env thật lên GitHub.
# ===========================================================

NODE_ENV=production
PORT=3000
SITE_URL=https://ten-mien-cua-ban.com

# ----- Thông tin chuyên viên tư vấn -----
# (Đã có sẵn trong config/site.js — chỉ cần đặt khi muốn đổi)
AGENT_NAME=Nguyễn Đăng Nhiên
AGENT_TITLE=Chuyên viên tư vấn dự án Gamuda Central Park
AGENT_PHONE=0985227566
AGENT_PHONE_DISPLAY=0985 227 566
AGENT_ZALO=0985227566
AGENT_EMAIL=annhien.manager@gmail.com
# Ảnh vuông (avatar) và ảnh dọc 4:5 (mục Liên hệ) trong public/images/
AGENT_PHOTO=/images/agent.webp
AGENT_PORTRAIT=/images/agent-portrait.webp

# ----- Kênh 1: Email (SMTP) -----
# Email Hostinger: smtp.hostinger.com, cổng 465
# Gmail: smtp.gmail.com, cổng 465, SMTP_PASS là "Mật khẩu ứng dụng" 16 ký tự
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# ----- Kênh 2: Google Sheet (Apps Script Web App) -----
GOOGLE_SHEET_WEBHOOK=
GOOGLE_SHEET_SECRET=

# ----- Kênh 3: Telegram -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- Mã theo dõi (để trống nếu chưa dùng) -----
GA4_ID=
GTM_ID=
FB_PIXEL_ID=
