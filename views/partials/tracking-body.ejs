<% if (tracking.gtm) { %>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= tracking.gtm %>" height="0" width="0" style="display:none;visibility:hidden" title="gtm"></iframe></noscript>
<% } %>
<% if (tracking.fbPixel) { %>
<noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=<%= tracking.fbPixel %>&ev=PageView&noscript=1"></noscript>
<% } %>
