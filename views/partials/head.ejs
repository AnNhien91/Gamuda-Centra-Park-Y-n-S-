<%
  const pageTitle = locals.title || site.title;
  const pageDesc = locals.description || site.description;
  const canonical = site.url + (locals.canonicalPath || path);
-%>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <script>document.documentElement.classList.add('js')</script>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <link rel="canonical" href="<%= canonical %>">
  <meta name="theme-color" content="#0E2A22">
  <% if (locals.noindex) { %><meta name="robots" content="noindex"><% } %>

  <meta property="og:type" content="website">
  <meta property="og:locale" content="<%= site.locale %>">
  <meta property="og:site_name" content="<%= site.name %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= site.url %>/images/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap">
  <% if (locals.preloadHero) { %>
  <link rel="preload" as="image" href="<%= img('aerial-lake', 960) %>" imagesrcset="<%= img('aerial-lake', 960) %> 960w, <%= img('aerial-lake') %> 1920w" imagesizes="100vw" fetchpriority="high">
  <% } %>
  <link rel="stylesheet" href="/css/style.css?v=<%= v %>">

  <%- include('tracking-head') %>
  <% if (locals.schema) { %><script type="application/ld+json"><%- JSON.stringify(locals.schema) %></script><% } %>
</head>
<body class="<%= locals.bodyClass || '' %>">
  <%- include('tracking-body') %>
  <a class="skip-link" href="#main">Bỏ qua, tới nội dung chính</a>
